# Copy to .env and fill in. Never commit .env.
PRIM_API_KEY=
# Station polled by the unitary request. Default: Cité Universitaire. See `make stations`.
PRIM_STATION_REF=STIF:StopArea:SP:473843:

# Token required to create, list or delete subscriptions (Authorization: Bearer ...).
# Leave empty to close those endpoints. Generate one with `openssl rand -hex 24`.
API_TOKEN=

# Database password. Local development works with this default; on the server, set a long
# random one before the first `make collector-up`.
POSTGRES_PASSWORD=belate

# Local development only (see deploy/compose/docker-compose.yml).
POSTGRES_USER=belate
POSTGRES_DB=belate
POSTGRES_PORT=5432
REDIS_PORT=6379
